# datamoov runtime configuration.
# ./setup.sh asks three questions and writes .env from this file, so most
# people never edit it by hand. Everything below "Optional" has a safe default.

# ---------------------------------------------------------------------------
# 1. Application images (this release)
# ---------------------------------------------------------------------------
# Pinned by immutable @sha256 digest: tags can move, digests cannot. To
# upgrade, copy these two lines from a newer .env.example into your .env.
DATAMOV_BACKEND_IMAGE=ghcr.io/justdataplease/datamoov-backend@sha256:e5f042c614874844c1d71ed658490a9c9f70695755f7a2344fd2ae470f8004ef
DATAMOV_FRONTEND_IMAGE=ghcr.io/justdataplease/datamoov-frontend@sha256:408df1a3b25d154ec407aeefa343259f3c36652e1141cdc2d6f6ec05ee291a34

# ---------------------------------------------------------------------------
# 2. Which pieces run (set by setup.sh)
# ---------------------------------------------------------------------------
# docker-compose.yml          always
# docker-compose.https.yml    automatic HTTPS on ports 80/443
# docker-compose.http.yml     plain HTTP, trusted private networks only
# docker-compose.localdb.yml  bundled PostgreSQL instead of a managed one
COMPOSE_PATH_SEPARATOR=:
COMPOSE_FILE=docker-compose.yml

# ---------------------------------------------------------------------------
# 3. Control database
# ---------------------------------------------------------------------------
# The URL must include sslmode=require, verify-ca, or verify-full; plaintext
# PostgreSQL is rejected. Bundled database: the host is `db`.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# Bundled database only.
POSTGRES_PASSWORD=

# ---------------------------------------------------------------------------
# 4. Address users will open
# ---------------------------------------------------------------------------
# A domain or the server's IP address. docker-compose.https.yml only.
DATAMOOV_SITE_ADDRESS=
# The same address in the forms the application needs. Use http:// instead of
# https:// everywhere when running docker-compose.http.yml.
ALLOWED_HOSTS=data.example.com
CORS_ORIGINS=https://data.example.com
CSRF_TRUSTED_ORIGINS=https://data.example.com
PLATFORM_PUBLIC_URL=https://data.example.com
MCP_ALLOWED_ORIGINS=["https://data.example.com"]

# ---------------------------------------------------------------------------
# 5. Secrets (setup.sh generates all five)
# ---------------------------------------------------------------------------
# Every value must be independent; never reuse one value for two settings.
# Back up FERNET_KEY: saved connector credentials cannot be decrypted without it.
# To generate by hand:
#   SECRET_KEY / INTERNAL_API_TOKEN / BOOTSTRAP_TOKEN:
#     openssl rand -base64 48 | tr '+/' '-_' | tr -d '=\n'
#   FERNET_KEY / QUERY_RUNNER_CREDENTIAL_KEY:
#     openssl rand -base64 32 | tr '+/' '-_'
SECRET_KEY=
FERNET_KEY=
QUERY_RUNNER_CREDENTIAL_KEY=
INTERNAL_API_TOKEN=

# First installation only. Use it once at /bootstrap, then blank it and
# recreate the backend container.
BOOTSTRAP_TOKEN=

# ===========================================================================
# Optional
# ===========================================================================

# Assistant providers. Leave an unused provider blank.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# Host exposure and local imports directory. Ignored by
# docker-compose.https.yml, which publishes 80/443 itself.
EDGE_UI_PORT=80
EDGE_API_PORT=8000
# Used only by docker-compose.http.yml. 0.0.0.0 publishes plaintext HTTP to the
# network; keep 127.0.0.1 unless that network is trusted and private.
EDGE_HTTP_BIND_HOST=127.0.0.1
DATAMOV_IMPORTS_DIR=./imports

# Normally leave these blank to use the pinned upstream images in Compose.
# Offline installations may set them to locally loaded tags.
DATAMOV_EDGE_IMAGE=
DATAMOV_GLANCES_IMAGE=

# Control-database connection budget.
CONTROL_DB_POOL_MODE=direct
CONTROL_DB_MAX_CONNECTIONS=120
CONTROL_DB_RESERVED_CONNECTIONS=15
BACKEND_WORKERS=2
BACKEND_THREADS=8
QUERY_RUNNER_WORKERS=2
QUERY_RUNNER_THREADS=4
QUERY_RUNNER_CREDENTIAL_TTL_SECONDS=30
ASSISTANT_WORKER_REPLICAS=1
ASSISTANT_WORKER_CONCURRENCY=4
ASSISTANT_GLOBAL_CONCURRENCY=4
CONTROL_DB_ETL_OPERATIONS_BUDGET=12

# Query/cache tuning. Defaults are production-safe; change a shared value
# coherently across its producer and consumer roles when tuning.
QUERY_CACHE_TTL_SECONDS=21600
QUERY_CACHE_STALE_SECONDS=86400
QUERY_CACHE_MAX_RESULT_BYTES=8388608
QUERY_CACHE_MAX_ENTRIES=10000
QUERY_CACHE_MAX_TOTAL_BYTES=536870912
QUERY_CACHE_MAINTENANCE_BATCH_SIZE=512
QUERY_EXECUTION_TIMEOUT_SECONDS=45
SEMANTIC_SNAPSHOT_CACHE_MAX_ENTRIES=8
SEMANTIC_COMPILED_SQL_CACHE_MAX_ENTRIES=256
SEMANTIC_COMPILED_SQL_CACHE_MAX_BYTES=16777216
WORKER_IDLE_POLL_MAX_SECONDS=2

# Resource ceilings, sized for a dedicated host with about 32 GiB RAM and
# 16 vCPUs. Tune only after measuring real pipelines.
INIT_MEMORY_LIMIT=1g
INIT_CPUS_LIMIT=1.0
INIT_PIDS_LIMIT=256
BACKEND_MEMORY_LIMIT=1g
BACKEND_CPUS_LIMIT=1.0
BACKEND_PIDS_LIMIT=256
QUERY_RUNNER_MEMORY_LIMIT=2g
QUERY_RUNNER_CPUS_LIMIT=2.0
QUERY_RUNNER_PIDS_LIMIT=256
FRONTEND_MEMORY_LIMIT=512m
FRONTEND_CPUS_LIMIT=0.5
FRONTEND_PIDS_LIMIT=128
EDGE_MEMORY_LIMIT=128m
EDGE_CPUS_LIMIT=0.25
EDGE_PIDS_LIMIT=64
GLANCES_MEMORY_LIMIT=512m
GLANCES_CPUS_LIMIT=0.5
GLANCES_PIDS_LIMIT=256
WORKER_MEMORY_LIMIT=12g
WORKER_MEMORY_ENVELOPE_MB=12288
WORKER_CPUS_LIMIT=4.0
WORKER_PIDS_LIMIT=512
WORKER_STATE_DISK_MIN_FREE_GB=5
ASSISTANT_WORKER_MEMORY_LIMIT=1g
ASSISTANT_WORKER_CPUS_LIMIT=1.0
ASSISTANT_WORKER_PIDS_LIMIT=256
